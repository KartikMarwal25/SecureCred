{
  "name": "securecred",
  "private": true,
  "version": "1.0.0",
  "description": "SecureCred — Blockchain-Based Digital Certification System (SKIT/CSE/2023-2027/26)",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:migrate": "node db/migrate.js up",
    "db:seed": "node db/seeds/seed.js",
    "contracts:compile": "npm run compile --workspace=contracts",
    "contracts:test": "npm run test --workspace=contracts",
    "contracts:node": "npm run node --workspace=contracts",
    "contracts:deploy:local": "npm run deploy:local --workspace=contracts",
    "api:dev": "npm run dev --workspace=apps/api",
    "api:test": "npm run test --workspace=apps/api",
    "worker:dev": "npm run dev --workspace=apps/worker",
    "web:dev": "npm run dev --workspace=apps/web",
    "web:build": "npm run build --workspace=apps/web",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.3"
  },
  "license": "UNLICENSED"
}
