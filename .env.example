# Copy this file to .env at the repo root and fill in real values.
# Nothing environment-specific is ever hard-coded in source (NFR-MAINT, LLD §10).

# --- Core ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
VERIFY_BASE_URL=http://localhost:5173/verify
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
DATABASE_URL=postgres://securecred_app:securecred_dev_password@localhost:5432/securecred
DATABASE_SSL=false

# --- Clerk (identity) --- https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Pinata (IPFS pinning) --- https://app.pinata.cloud
PINATA_JWT=
IPFS_GATEWAYS=https://gateway.pinata.cloud/ipfs,https://ipfs.io/ipfs,https://cloudflare-ipfs.com/ipfs

# --- Blockchain ---
# CHAIN_NETWORK must match a Hardhat network name AND the filename written by
# `contracts/scripts/deploy.js` under contracts/deployments/<CHAIN_NETWORK>.json.
# localhost -> local Hardhat node (`npm run contracts:node`), chainId 1337, confirmation depth 1
# amoy      -> Polygon Amoy testnet, chainId 80002, confirmation depth 5
# polygon   -> Polygon mainnet, chainId 137, confirmation depth 30
CHAIN_NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337
CONTRACT_ADDRESS=
CONFIRMATION_DEPTH=1
CUSTODIAN_PRIVATE_KEY=

# --- Rate limits (requests) ---
RATE_VERIFY_PER_MINUTE=30
RATE_VERIFY_PER_HOUR=600
RATE_AUTH_PER_MINUTE=10
RATE_ISSUANCE_PER_HOUR=60
RATE_REVOCATION_PER_HOUR=20

# --- Worker ---
STALL_THRESHOLD_SEC=120
RECONCILE_INTERVAL_SEC=60

# --- Web (Vite, must be prefixed VITE_) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_BASE_URL=http://localhost:4000/api/v1
